# Rahasia JWT: teks acak panjang (minimal 32 karakter).
JWT_SECRET=
JWT_REFRESH_SECRET=

APP_ENV=
PORT=8080

# Kunci enkripsi berkas. Panjang WAJIB tepat:
# AES256 = 32 karakter, DES = 8 karakter, RC4 = bebas (disarankan 32).
# Mengganti kunci membuat berkas lama tidak bisa didekripsi lagi.
DATABASE_SECRET_AES256=
DATABASE_SECRET_DES=
DATABASE_SECRET_RC4=
