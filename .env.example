# Rahasia JWT: teks acak panjang (minimal 32 karakter).
JWT_SECRET=
JWT_REFRESH_SECRET=

APP_ENV=
PORT=8080

# Kunci enkripsi berkas. Panjang WAJIB tepat:
# AES256 = 32 karakter, DES = 8 karakter, RC4 = bebas (disarankan 32).
# Mengganti kunci membuat berkas lama tidak bisa didekripsi lagi.
# Legacy
DATABASE_SECRET_AES256=
DATABASE_SECRET_DES=
DATABASE_SECRET_RC4=

# 32 Karakter contoh generate: `openssl rand -base64 32`
DATABASE_MASTER_KEK=

# Pengiriman paket kunci lewat Gmail SMTP.
# GMAIL_APP_PASSWORD = App Password Google (16 huruf), bukan kata sandi akun.
# Buat di https://myaccount.google.com/apppasswords (wajib aktifkan 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
